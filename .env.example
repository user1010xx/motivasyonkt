# === Railway / yerel ortam değişkenleri ===
# Gerçek secret'ları ASLA commit etmeyin. Yalnızca Railway Variables veya yerel .env

# Telegram BotFather token
TELEGRAM_BOT_TOKEN=

# Senin Telegram user id'n (zorunlu). Virgülle birden fazla eklenebilir.
# Id öğrenmek: @userinfobot
TELEGRAM_ADMIN_IDS=

# Otomatik motivasyon mesajı gidecek grup id(leri)
# Tek grup: TELEGRAM_CHAT_ID=-100...
# Birden fazla: TELEGRAM_CHAT_IDS=-100111,-100222
TELEGRAM_CHAT_ID=
# TELEGRAM_CHAT_IDS=

# Toniva CRM Public API (Railway'de gir)
TONIVA_BASE_URL=https://crm.toniva.net/api/public/v1
TONIVA_API_KEY=

# Zamanlama
TIMEZONE=Europe/Istanbul
SCHEDULE_SABAH=09:00
SCHEDULE_OGLEN=13:00
SCHEDULE_AKSAM=18:00
ENABLE_SCHEDULE=true

# true = örnek veri (Toniva key olmadan deneme)
MOCK_MODE=false
